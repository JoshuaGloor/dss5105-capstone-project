# Copy to .env and fill in YOUR OWN keys. .env is gitignored, never commit it.

# Which model to use. Format: "<provider>:<model>"
# Using this env variable instead of hardcoding them inside the code allows us
# to experiment and use different models.
# E.g.,:
# Anthropic: anthropic:claude-sonnet-5
# OpenAI:    openai:gpt-4.1
LLM_MODEL=anthropic:claude-sonnet-5

# Only the key for the provider you're actually using is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
